#===================================================================
# FML shared build configuration
# Hans A. Winther (hans.a.winther@gmail.com)
#
# Every Makefile in the library includes this file. A Makefile sets
# the options it needs (with ?=) and the list of TARGETS *before*
# including it, and adds its own rules after.
#
# To change compiler, library paths or options for your machine
# without editing tracked files, put the settings in
#   Makefile.local   (in the same folder as this file, not tracked by git)
# or pass them on the command line, e.g.
#   make USE_MPI=false USE_DEBUG=true
#
# Command line > Makefile.local > example Makefile > defaults below
#===================================================================

SHELL := /bin/bash

# Location of the library (the folder containing this file). Headers are
# included as <FML/...> so the include path is the folder *above* it
FML_ROOT    := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
FML_INCLUDE ?= $(abspath $(FML_ROOT)/..)

# Machine specific overrides
-include $(FML_ROOT)/Makefile.local

#===================================================
# Compilers and flags
#===================================================

CXX_SERIAL ?= g++
CXX_MPI    ?= mpicxx
CXXSTD     ?= -std=c++17
CXXFLAGS   ?= -O3 -Wall -Wextra -march=native

#===================================================
# Options (all off unless the including Makefile or
# the user turns them on)
#===================================================

# Parallelization
USE_MPI          ?= false
USE_OMP          ?= false
# FFTW (+ threads in FFTW, only used if USE_OMP)
USE_FFTW         ?= false
USE_FFTW_THREADS ?= false
# Log allocations in the library
USE_MEMORYLOG    ?= false
# Address sanitizer (check for bad memory accesses)
USE_SANITIZER    ?= false
# Turn on the extra DEBUG_OPTIONS defined in the including Makefile
USE_DEBUG        ?= false
# External libraries
USE_GSL          ?= false
USE_LUA          ?= false
USE_HEALPIX      ?= false
USE_CHUNKPIX     ?= false
USE_CGAL         ?= false
USE_PYTHON       ?= false

#===================================================
# Paths to external libraries. Defaults assume
# everything is installed in $(HOME)/local
#===================================================

LOCAL_PREFIX   ?= $(HOME)/local

FFTW_INCLUDE   ?= $(LOCAL_PREFIX)/include
FFTW_LIB       ?= $(LOCAL_PREFIX)/lib
FFTW_LINK      ?= -lfftw3
FFTW_MPI_LINK  ?= -lfftw3_mpi
FFTW_OMP_LINK  ?= -lfftw3_threads

GSL_INCLUDE    ?= $(LOCAL_PREFIX)/include
GSL_LIB        ?= $(LOCAL_PREFIX)/lib
GSL_LINK       ?= -lgsl -lgslcblas

LUA_INCLUDE    ?= $(LOCAL_PREFIX)/include
LUA_LIB        ?= $(LOCAL_PREFIX)/lib
LUA_LINK       ?= -llua -ldl

HP_INCLUDE      ?= $(LOCAL_PREFIX)/Healpix_3.82_gcc/include/healpix_cxx/
HP_LIB          ?= $(LOCAL_PREFIX)/Healpix_3.82_gcc/lib
CFITSIO_INCLUDE ?= $(LOCAL_PREFIX)/include
CFITSIO_LIB     ?= $(LOCAL_PREFIX)/lib
HP_LINK         ?= -lhealpix_cxx -lsharp -lcfitsio

# CGAL is header only (older versions needed -lCGAL)
CGAL_INCLUDE   ?= /opt/local/include
CGAL_LIB       ?= /opt/local/lib
CGAL_LINK      ?= -lgmp -lm

# Python (for plotting with matplotlib and the SWIG wrappers)
PYTHON         ?= python3
PYTHON_INCLUDE ?= $(shell $(PYTHON) -c "import sysconfig; print(sysconfig.get_paths()['include'])" 2>/dev/null)
NUMPY_INCLUDE  ?= $(shell $(PYTHON) -c "import numpy; print(numpy.get_include())" 2>/dev/null)
PYTHON_LINK    ?= $(shell $(PYTHON)-config --ldflags --embed 2>/dev/null || $(PYTHON)-config --ldflags 2>/dev/null)

#===================================================
# Assemble compiler, defines, includes and libraries
#===================================================

ifeq ($(USE_MPI),true)
CC       = $(CXX_MPI) $(CXXSTD) $(CXXFLAGS)
else
CC       = $(CXX_SERIAL) $(CXXSTD) $(CXXFLAGS)
endif

# OPTIONS may already contain settings from the including Makefile
INC     += -I$(FML_INCLUDE)
LIB     +=
LINK    +=

ifeq ($(USE_MPI),true)
OPTIONS += -DUSE_MPI
endif

ifeq ($(USE_OMP),true)
OPTIONS += -DUSE_OMP
CC      += -fopenmp
endif

ifeq ($(USE_SANITIZER),true)
CC      += -g -fsanitize=address
endif

ifeq ($(USE_DEBUG),true)
OPTIONS += $(DEBUG_OPTIONS)
endif

ifeq ($(USE_FFTW),true)
OPTIONS += -DUSE_FFTW
INC     += -I$(FFTW_INCLUDE)
LIB     += -L$(FFTW_LIB)
ifeq ($(USE_MPI),true)
LINK    += $(FFTW_MPI_LINK)
endif
ifeq ($(USE_OMP),true)
ifeq ($(USE_FFTW_THREADS),true)
OPTIONS += -DUSE_FFTW_THREADS
LINK    += $(FFTW_OMP_LINK)
endif
endif
LINK    += $(FFTW_LINK)
endif

ifeq ($(USE_MEMORYLOG),true)
OPTIONS += -DMEMORY_LOGGING
endif

ifeq ($(USE_GSL),true)
OPTIONS += -DUSE_GSL
INC     += -I$(GSL_INCLUDE)
LIB     += -L$(GSL_LIB)
LINK    += $(GSL_LINK)
endif

ifeq ($(USE_LUA),true)
OPTIONS += -DUSE_LUA
INC     += -I$(LUA_INCLUDE)
LIB     += -L$(LUA_LIB)
LINK    += $(LUA_LINK)
endif

ifeq ($(USE_HEALPIX),true)
OPTIONS += -DUSE_HEALPIX
INC     += -I$(HP_INCLUDE) -I$(CFITSIO_INCLUDE)
LIB     += -L$(HP_LIB) -L$(CFITSIO_LIB)
LINK    += $(HP_LINK)
ifeq ($(USE_CHUNKPIX),true)
OPTIONS += -DUSE_CHUNKPIX
endif
endif

ifeq ($(USE_CGAL),true)
OPTIONS += -DUSE_CGAL
INC     += -I$(CGAL_INCLUDE)
LIB     += -L$(CGAL_LIB)
LINK    += $(CGAL_LINK)
endif

ifeq ($(USE_PYTHON),true)
INC     += -I$(PYTHON_INCLUDE) -I$(NUMPY_INCLUDE)
LINK    += $(PYTHON_LINK)
endif

#===================================================
# Where to find the library .cpp files. Set
# FML_MODULES (e.g. Global Spline ODESolver) in the
# including Makefile, and EXTRA_VPATH for anything else
#===================================================

VPATH = $(addprefix $(FML_ROOT)/,$(FML_MODULES)) $(EXTRA_VPATH)

#===================================================
# Rules
#===================================================

# Link an executable from its prerequisites: use as the recipe
LINK_EXE = $(CC) -o $@ $^ $(OPTIONS) $(LIB) $(LINK)

.DEFAULT_GOAL := all
.PHONY: all clean
all: $(TARGETS)

clean:
	rm -rf $(TARGETS) $(EXTRA_CLEAN) *.o *.d

# Also write dependency files so objects are rebuilt when headers change
DEPFLAGS ?= -MMD -MP

%.o: %.cpp
	$(CC) $(DEPFLAGS) -c -o $@ $< $(OPTIONS) $(INC)

-include $(wildcard *.d)
